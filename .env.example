# Pitwall — environment variables
#
# Copy this file to `.env` in this same folder and fill in your own key:
#
#     cp .env.example .env
#
# If there is no `.env` here, the backend falls back to the `.env` one level up.
# `.env` is gitignored and must never be committed.

# Required. Portkey API key, used to reach the OpenAI model through Portkey.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. Only needed if you call OpenAI directly instead of through Portkey.
OPENAI_API_KEY=your-openai-api-key-here

# Optional. The chat model. Defaults to gpt-6-luna when unset.
MODEL_NAME=gpt-6-luna

# Optional, frontend only. Where the React app looks for the backend.
# Defaults to http://localhost:8000 when unset.
VITE_API_BASE=http://localhost:8000

# Optional, bake script only. An F1 account, used solely as a fallback to pull
# qualifying laps through FastF1 for a session OpenF1 has no laps for (2025:
# Azerbaijan qualifying). FastF1 3.9 needs the account to have an active F1TV
# subscription. Leave unset if you don't have one: the bake skips the fallback
# and flags the gap. The app never reads these.
# F1_USERNAME=you@example.com
# F1_PASSWORD=your-f1-password
